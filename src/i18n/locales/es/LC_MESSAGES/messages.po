#: src/cli/commands.py:69
msgid "cli.epilog"
msgstr ""
"cli.epilogEjemplos:\n"
"  %(prog)s                              # Iniciar la interfaz gráfica\n"
"  %(prog)s gui                          # Iniciar explícitamente la GUI\n"
"  %(prog)s scan ~/Music                 # Escanear y mostrar resumen\n"
