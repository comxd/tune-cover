msgstr "TuneCover - Récupère et intègre les pochettes d'albums."

#: src/cli/commands.py:69
msgid "cli.epilog"
msgstr ""
"cli.epilogExemples:\n"
"  %(prog)s                              # Lance l'interface graphique\n"
"  %(prog)s gui                          # Lance explicitement la GUI\n"
"  %(prog)s scan ~/Music                 # Scanne et affiche le résumé\n"
"  %(prog)s scan ~/Music -o report.json  # Scanne et exporte en JSON\n"
"  %(prog)s fetch report.json --auto     # Récupère les pochettes "
"automatiquement"

