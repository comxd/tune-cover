msgstr "TuneCover - Recupera e integra le copertine degli album."

#: src/cli/commands.py:69
msgid "cli.epilog"
msgstr ""
"cli.epilogEsempi:\n"
"  %(prog)s                              # Avvia l'interfaccia grafica\n"
"  %(prog)s gui                          # Avvia esplicitamente la GUI\n"
"  %(prog)s scan ~/Music                 # Scansiona e mostra il riepilogo"
"\n"
"  %(prog)s scan ~/Music -o report.json  # Scansiona ed esporta in JSON\n"
"  %(prog)s fetch report.json --auto     # Recupera automaticamente le "
"copertine"

